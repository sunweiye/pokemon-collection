# PostgreSQL host for Docker Compose (direct local Spring Boot fallback: localhost).
POSTGRES_HOST=
# PostgreSQL port for Docker Compose.
POSTGRES_PORT=
# PostgreSQL database name for Docker Compose.
POSTGRES_DB=
# PostgreSQL application username for Docker Compose.
POSTGRES_USER=
# PostgreSQL application password for Docker Compose; never commit the real value.
POSTGRES_PASSWORD=
# Persistent Pokémon cache freshness window, in days (default: 7).
APP_POKEMON_CACHE_TTL_DAYS=7
# Directory for backend log files, relative to the backend's working directory or absolute (default: logs).
LOG_PATH=logs
# Whether the JSESSIONID cookie requires HTTPS; set to true in production behind HTTPS (default: false).
SESSION_COOKIE_SECURE=false
# Whether Thymeleaf caches templates (production default: true; development profile default: false).
THYMELEAF_CACHE=true
